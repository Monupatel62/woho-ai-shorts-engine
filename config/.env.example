OLLAMA_MODEL=llama3.2
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private

# Advanced Human Avatar Engine
# off = existing scene engine
# musetalk = presenter video + audio-driven lip-sync
AVATAR_MODE=off
AVATAR_SOURCE=E:\\AI-Shorts\\avatars\\presenter.mp4
AVATAR_RAW_SOURCE=E:\\AI-Shorts\\avatars\\presenter-original.mp4
AVATAR_BACKGROUND=E:\\AI-Shorts\\avatars\\wohoTech-presenter-background.png
AVATAR_PREPARE=true
AVATAR_BACKGROUND_PYTHON=E:\\AI-Shorts\\avatar\\background-venv\\Scripts\\python.exe
MUSETALK_ROOT=E:\\AI-Shorts\\avatar\\MuseTalk
MUSETALK_PYTHON=E:\\AI-Shorts\\avatar\\musetalk-venv\\Scripts\\python.exe
MUSETALK_BATCH_SIZE=1
MUSETALK_FLOAT16=false
AVATAR_TRACKING=true
AVATAR_TRACKER_PYTHON=E:\\AI-Shorts\\avatar\\tracking-venv\\Scripts\\python.exe
AVATAR_RESULT_DIR=E:\\AI-Shorts\\output\\avatars
FFMPEG_PATH=E:\\AI-Shorts\\ffmpeg\\bin
