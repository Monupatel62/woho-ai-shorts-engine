OLLAMA_MODEL=llama3.2
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private

# Root directory (used as base for all default paths)
AI_ROOT=E:\\AI-Shorts

# Voice (Piper TTS)
PIPER_PATH=E:\\AI-Shorts\\ollama\\tts-venv\\Scripts\\piper.exe
PIPER_MODEL=E:\\AI-Shorts\\models\\piper\\en_US-lessac-medium.onnx
AUDIO_DIR=E:\\AI-Shorts\\audio

# FFmpeg
FFMPEG_PATH=E:\\AI-Shorts\\ffmpeg\\bin
FFMPEG_BIN=E:\\AI-Shorts\\ffmpeg\\bin\\ffmpeg.exe
FFPROBE_PATH=E:\\AI-Shorts\\ffmpeg\\bin\\ffprobe.exe

# Media & Video
# MEDIA_DIRS: semicolon-separated list of folders scanned for background images/videos
MEDIA_DIRS=E:\\AI-Shorts\\images;E:\\AI-Shorts\\videos
VIDEO_DIR=E:\\AI-Shorts\\videos

# Advanced Human Avatar Engine
# off          = scene engine only, no avatar (default)
# hf-sadtalker = FREE via Hugging Face ZeroGPU, 5min GPU/day per account (RECOMMENDED)
# sadtalker    = fal.ai cloud API, pay-per-use (~$0.01-0.05/video)
# musetalk     = local, requires NVIDIA GPU
AVATAR_MODE=off

# Hugging Face free token — get at https://huggingface.co/settings/tokens
# Free account = 5 min GPU/day (~2 videos/day), no credit card needed
HF_TOKEN=

# fal.ai API key (only needed for AVATAR_MODE=sadtalker)
FAL_KEY=

# Presenter image for SadTalker (auto-extracted from AVATAR_SOURCE first frame)
AVATAR_IMAGE=E:\\AI-Shorts\\avatars\\presenter.jpg

AVATAR_SOURCE=E:\\AI-Shorts\\avatars\\presenter.mp4
AVATAR_RAW_SOURCE=E:\\AI-Shorts\\avatars\\presenter-original.mp4
AVATAR_BACKGROUND=E:\\AI-Shorts\\avatars\\wohoTech-presenter-background.png
AVATAR_PREPARE=true
AVATAR_BACKGROUND_PYTHON=E:\\AI-Shorts\\avatar\\background-venv\\Scripts\\python.exe
MUSETALK_ROOT=E:\\AI-Shorts\\avatar\\MuseTalk
MUSETALK_PYTHON=E:\\AI-Shorts\\avatar\\musetalk-venv\\Scripts\\python.exe
MUSETALK_BATCH_SIZE=1
MUSETALK_FLOAT16=false
AVATAR_TRACKING=true
AVATAR_TRACKER_PYTHON=E:\\AI-Shorts\\avatar\\tracking-venv\\Scripts\\python.exe
AVATAR_RESULT_DIR=E:\\AI-Shorts\\output\\avatars
