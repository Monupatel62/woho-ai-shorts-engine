import { spawn } from "node:child_process";
import { mkdir } from "node:fs/promises";
import path from "node:path";

export interface VideoOptions {
  audioPath: string;
  outputName?: string;
  title?: string;
}

export interface VideoResult {
  videoPath: string | null;
  status: "completed" | "failed";
}

const FFMPEG = "E:\\AI-Shorts\\ffmpeg\\bin\\ffmpeg.exe";
const VIDEO_DIR = "E:\\AI-Shorts\\videos";

export async function generateVideo(
  options: VideoOptions
): Promise<VideoResult> {
  await mkdir(VIDEO_DIR, { recursive: true });

  const outputName =
    options.outputName ?? `short-${Date.now()}.mp4`;

  const outputPath = path.join(VIDEO_DIR, outputName);

  console.log("\nVideo Engine");
  console.log("Resolution: 1080x1920");
  console.log(`Title: ${options.title ?? "AI Short"}`);
  console.log(`Audio: ${options.audioPath}`);
  console.log(`Output: ${outputPath}`);

  const args = [
    "-y",

    "-f",
    "lavfi",
    "-i",
    "color=c=black:s=1080x1920:r=30",

    "-i",
    options.audioPath,

    "-map",
    "0:v:0",
    "-map",
    "1:a:0",

    "-c:v",
    "libx264",
    "-preset",
    "veryfast",
    "-crf",
    "23",

    "-c:a",
    "aac",
    "-b:a",
    "128k",

    "-pix_fmt",
    "yuv420p",

    "-shortest",

    outputPath
  ];

  return new Promise((resolve) => {
    const process = spawn(FFMPEG, args, {
      windowsHide: true
    });

    let stderr = "";

    process.stderr.on("data", (data: Buffer) => {
      stderr += data.toString();
    });

    process.on("error", (error) => {
      console.error("[video] FFmpeg error:", error);

      resolve({
        videoPath: null,
        status: "failed"
      });
    });

    process.on("close", (code) => {
      if (code === 0) {
        console.log("[video] video generated successfully");

        resolve({
          videoPath: outputPath,
          status: "completed"
        });
      } else {
        console.error("[video] FFmpeg failed");
        console.error(stderr);

        resolve({
          videoPath: null,
          status: "failed"
        });
      }
    });
  });
}
